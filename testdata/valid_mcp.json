{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "local-tool": {
      "type": "stdio",
      "command": "./bin/server",
      "args": ["--arg1"],
      "env": {
        "KEY": "value"
      },
      "cwd": "${PLUGIN_ROOT}"
    },
    "remote-tool": {
      "type": "streamable-http",
      "url": "https://api.example.com/mcp",
      "headers": {
        "X-Custom-Header": "value"
      }
    }
  }
}
